# Global leaderboard : servi par le serveur de jeu (GET /leaderboard). AUCUN token
# Upstash dans l'app — même « read-only », il lit toute la base (claim tokens, comptes).

# RPSLSWatcher — télémétrie des parties Arena Pro (POST /api/matches).
# Mets ces deux lignes dans app/.env (gitignoré). La clé doit être IDENTIQUE à
# l'INGEST_KEY posée dans Cloudflare Pages (Settings → Environment variables).
# Si vide → le recorder est INERTE (le jeu marche pareil).
VITE_WATCHER_URL=https://rpslswatcher.pages.dev
VITE_WATCHER_INGEST_KEY=

# Sentry : DSN public du projet. Vide → Sentry désactivé.
VITE_SENTRY_DSN=
# Version taguée sur les événements Sentry (défaut : "dev").
VITE_APP_VERSION=

# Client OAuth Web Google (`aud` des ID tokens). Vide → bouton Google masqué.
VITE_GOOGLE_CLIENT_ID=
